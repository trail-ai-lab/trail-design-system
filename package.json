{
  "name": "@trail-ai-lab/trail-design-system",
  "version": "1.8.1",
  "private": false,
  "license": "MIT",
  "description": "TRAIL Lab design system — shared foundations, primitives and patterns for TRAIL lab tools (SLAI, Lab Website).",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./ui": {
      "import": {
        "types": "./dist/ui/index.d.mts",
        "default": "./dist/ui/index.mjs"
      },
      "require": {
        "types": "./dist/ui/index.d.ts",
        "default": "./dist/ui/index.js"
      }
    },
    "./patterns": {
      "import": {
        "types": "./dist/patterns/index.d.mts",
        "default": "./dist/patterns/index.mjs"
      },
      "require": {
        "types": "./dist/patterns/index.d.ts",
        "default": "./dist/patterns/index.js"
      }
    },
    "./slai": {
      "import": {
        "types": "./dist/slai/index.d.mts",
        "default": "./dist/slai/index.mjs"
      },
      "require": {
        "types": "./dist/slai/index.d.ts",
        "default": "./dist/slai/index.js"
      }
    },
    "./lab-website": {
      "import": {
        "types": "./dist/lab-website/index.d.mts",
        "default": "./dist/lab-website/index.mjs"
      },
      "require": {
        "types": "./dist/lab-website/index.d.ts",
        "default": "./dist/lab-website/index.js"
      }
    },
    "./styles.css": "./src/tokens/styles.css",
    "./globals.css": "./src/tokens/globals.css",
    "./semantic.css": "./src/tokens/semantic.css",
    "./scales.css": "./src/tokens/scales.css",
    "./layout.css": "./src/tokens/layout.css",
    "./fonts.css": "./src/tokens/fonts.css"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/tokens/globals.css",
    "src/tokens/semantic.css",
    "src/tokens/scales.css",
    "src/tokens/layout.css",
    "src/tokens/fonts.css",
    "src/tokens/styles.css"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup && node scripts/add-use-client-banner.mjs",
    "prepare": "tsup && node scripts/add-use-client-banner.mjs",
    "dev": "tsup --watch",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "pnpm typecheck && eslint .",
    "ui:update": "node scripts/update-ui.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.lint.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:stories": "vitest run --project storybook",
    "check": "pnpm format:check && pnpm lint && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-mcp": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.1",
    "globals": "^17.13.0",
    "next-themes": "^0.4.6",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.52.0",
    "radix-ui": "^1.7.0",
    "react-day-picker": "^10.0.2",
    "react-qr-code": "^2.2.0",
    "react-resizable-panels": "^4.14.2",
    "recharts": "~3.8.0",
    "shadcn": "^4.21.3",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@11.3.0"
}
